#include <iostream>
#include <string>
#include <vector>
#include <map>
using namespace std;

// ----- Classes de base -----
class Type {
public:
    string nom;
    Type(string n) : nom(n) {}
};

class Attack {
public:
    string nom;
    int puissance;
    Type* type;
    Attack(string n, int p, Type* t) : nom(n), puissance(p), type(t) {}
};

class Pokemon {
public:
    string nom;
    int hp;
    vector<Type*> types;
    vector<Attack*> attaques;
    Pokemon(string n, int pv, vector<Type*> t, vector<Attack*> a)
        : nom(n), hp(pv), types(t), attaques(a) {}
};

class Joueur {
public:
    string nom;
    vector<Pokemon*> equipe;
    Joueur(string n, vector<Pokemon*> eq) : nom(n), equipe(eq) {}
};

class Leader {
public:
    string nom, gymnase, badge;
    vector<Pokemon*> equipe;
    Leader(string n, string g, string b, vector<Pokemon*> eq) : nom(n), gymnase(g), badge(b), equipe(eq) {}
};

class Maitre {
public:
    string nom;
    vector<Pokemon*> equipe;
    Maitre(string n, vector<Pokemon*> eq) : nom(n), equipe(eq) {}
};

